{
  "name": "temporal-assessment-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Juniper Salon: fill last-minute openings from the waitlist, one client at a time, with Temporal.",
  "scripts": {
    "start": "npm install --no-audit --no-fund && node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx src/api.ts",
    "dev:worker": "tsx src/worker.ts",
    "start:temporal": "docker compose up -d temporal",
    "stop": "docker compose down",
    "test": "tsx --test tests/eligibility.test.ts tests/requests.test.ts tests/activities.test.ts tests/workflow.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@temporalio/testing": "1.24.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
